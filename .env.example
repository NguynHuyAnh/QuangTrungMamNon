# Sao chép thành file `.env` ở thư mục gốc repo (cùng cấp README).
# API sẽ tự tìm `.env` từ thư mục chạy lệnh hoặc đi lên các thư mục cha.

# ── PostgreSQL (định dạng chuỗi Npgsql) ─────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=quangtrung_mn;Username=postgres;Password=YOUR_DB_PASSWORD_HERE

# ── JWT ────────────────────────────────────────────────────────────────────
Jwt__Issuer=QuangTrungKindergarten
Jwt__Audience=QuangTrungKindergartenClients
# Bắt buộc tối thiểu ~32 byte UTF-8; production đổi chuỗi dài ngẫu nhiên.
Jwt__Key=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS__
Jwt__AccessTokenMinutes=120

# ── ZaloPay (sandbox / production) ───────────────────────────────────────
ZaloPay__Enabled=false
ZaloPay__AppId=
ZaloPay__Key1=
ZaloPay__Key2=
ZaloPay__CreateEndpoint=https://sb-openapi.zalopay.vn/v2/create
ZaloPay__QueryEndpoint=https://sb-openapi.zalopay.vn/v2/query
# URL gốc HTTPS công khai (tunnel ngrok) + path callback do API định nghĩa
ZaloPay__CallbackBaseUrl=
# Sau thanh toán ZaloPay redirect về SPA
ZaloPay__ReturnRedirectUrl=http://localhost:5173/parent/payments?from=zalopay

# Bật sandbox demo (credential mẫu ZaloPay — chỉ dùng cho dev, không đưa production):
# ZaloPay__Enabled=true
# ZaloPay__AppId=2554
# ZaloPay__Key1=sdngKKJmqEMzvh5QQcdD2A9XBSKUNaYn
# ZaloPay__Key2=trMrHtvjo6myautxDUiAcYsVtaeQ8nhf
