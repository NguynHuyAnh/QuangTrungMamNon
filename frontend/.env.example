# Sao chép thành `frontend/.env` hoặc `frontend/.env.local` (Vite tự nạp).
# Chỉ các biến bắt đầu VITE_ mới lộ ra bundle.

# URL backend khi gọi trực tiếp (không dùng proxy dev). Để trống = dùng đường dẫn tương đối /api.
# VITE_API_BASE_URL=http://localhost:5022

# Cổng API cho Vite proxy (npm run dev). Mặc định vite.config đã là http://localhost:5022.
# VITE_PROXY_TARGET=http://127.0.0.1:5022

# Ghi log lỗi API chi tiết hơn ở bản production build (tuỳ chọn).
# VITE_DEBUG_API=true
